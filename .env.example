# Coolify > Environment Variables bölümüne bu değişkenleri gir.

# Panel giriş şifresi (uzun ve benzersiz olsun)
APP_PASSWORD=degistir-beni

# İsteğe bağlı: oturum imzalama anahtarı (boşsa şifreden türetilir)
# Üretmek için:  openssl rand -hex 32
SESSION_SECRET=

# Panel <-> WoL relay arası paylaşılan gizli anahtar
# Üretmek için:  openssl rand -hex 32
WOL_RELAY_TOKEN=degistir-beni-de

# Kaç saniyede bir durum kontrolü yapılsın
POLL_SECONDS=10

# Cihazlar (tek satır JSON). Alanlar README'de açıklandı.
DEVICES=[{"id":"pc","name":"Masaüstü","icon":"desktop","host":"192.168.1.20","mac":"AA:BB:CC:DD:EE:01","broadcast":"192.168.1.255","rustdeskId":"123456789","camUrl":"http://kamera:SIFRE@192.168.1.20:1984/api/stream.mjpeg?src=webcam"},{"id":"laptop","name":"Laptop","icon":"laptop","host":"192.168.1.21","mac":"AA:BB:CC:DD:EE:02","broadcast":"192.168.1.255","rustdeskId":"987654321","camUrl":"http://kamera:SIFRE@192.168.1.21:1984/api/stream.mjpeg?src=webcam"}]
